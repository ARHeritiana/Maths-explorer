{
  "schemaVersion": 1,
  "basis": "Site progression and declared entry knowledge, not certification of an official programme. Historical exams do not grant scope.",
  "concepts": {
    "numbers.rational": {
      "label": "Calcul sur les nombres et fractions",
      "requires": [],
      "patterns": []
    },
    "powers.integer": {
      "label": "Puissances entières",
      "requires": [
        "numbers.rational"
      ],
      "patterns": []
    },
    "algebra.linear": {
      "label": "Équations et inéquations du premier degré",
      "requires": [
        "numbers.rational"
      ],
      "patterns": []
    },
    "algebra.factorisation": {
      "label": "Développement et factorisation",
      "requires": [
        "algebra.linear"
      ],
      "patterns": [
        "factoris",
        "discriminant"
      ]
    },
    "algorithms.loop": {
      "label": "Boucles et accumulateurs",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "\\bwhile\\b",
        "\\bfor\\b.+\\brange\\b",
        "accumulateur"
      ]
    },
    "percentages": {
      "label": "Proportions et taux d’évolution",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "pourcent",
        "coefficient[s]? multiplicateur"
      ]
    },
    "geometry.triangle_cosine": {
      "label": "Cosinus dans un triangle",
      "requires": [
        "numbers.rational"
      ],
      "patterns": []
    },
    "functions.affine": {
      "label": "Fonctions affines",
      "requires": [
        "algebra.linear"
      ],
      "patterns": []
    },
    "numbers.divisibility": {
      "label": "Divisibilité des entiers",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "divisibilit",
        "congruence"
      ]
    },
    "geometry.vectors": {
      "label": "Vecteurs du plan",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "vecteurs?",
        "\\\\(?:overrightarrow|vect)\\b"
      ]
    },
    "geometry.lines": {
      "label": "Droites du plan",
      "requires": [
        "geometry.vectors",
        "algebra.linear"
      ],
      "patterns": [
        "\\bdroite\\b",
        "équation cartésienne"
      ]
    },
    "numbers.intervals": {
      "label": "Intervalles de réels",
      "requires": [
        "algebra.linear"
      ],
      "patterns": []
    },
    "functions.reference": {
      "label": "Fonctions de référence",
      "requires": [
        "algebra.linear"
      ],
      "patterns": []
    },
    "statistics.univariate": {
      "label": "Statistiques à une variable",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "quartile",
        "médiane"
      ]
    },
    "functions.variations": {
      "label": "Variations et extremums",
      "requires": [
        "functions.reference"
      ],
      "patterns": [
        "variations?",
        "extremum",
        "minimum",
        "maximum"
      ]
    },
    "probability.elementary": {
      "label": "Probabilités élémentaires",
      "requires": [
        "numbers.rational"
      ],
      "patterns": []
    },
    "probability.conditional": {
      "label": "Probabilités conditionnelles",
      "requires": [
        "probability.elementary"
      ],
      "patterns": [
        "probabilités? conditionnell",
        "conditionnement",
        "P\\s*\\([^)]*\\\\mid"
      ]
    },
    "probability.independence": {
      "label": "Indépendance d’événements",
      "requires": [
        "probability.conditional"
      ],
      "patterns": [
        "événements? indépendants?",
        "tirages? indépendants?"
      ]
    },
    "sequences.arithmetic": {
      "label": "Suites arithmétiques",
      "requires": [
        "functions.affine"
      ],
      "patterns": [
        "suites? arithmétique"
      ]
    },
    "sequences.geometric": {
      "label": "Suites géométriques",
      "requires": [
        "powers.integer",
        "percentages"
      ],
      "patterns": [
        "suites? géométrique"
      ]
    },
    "sequences.sum": {
      "label": "Sommes de termes de suites",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "sommes? géométrique",
        "sommes? de termes"
      ]
    },
    "sequences.threshold": {
      "label": "Recherche de seuil sur une suite",
      "requires": [
        "algorithms.loop",
        "sequences.geometric"
      ],
      "patterns": [
        "premier rang",
        "boucle de seuil"
      ]
    },
    "algebra.quadratic": {
      "label": "Équations et signe du second degré",
      "requires": [
        "algebra.factorisation"
      ],
      "patterns": [
        "second degré",
        "discriminant"
      ]
    },
    "geometry.dot_product": {
      "label": "Produit scalaire",
      "requires": [
        "geometry.vectors",
        "geometry.triangle_cosine"
      ],
      "patterns": [
        "produit scalaire"
      ]
    },
    "analysis.derivative": {
      "label": "Dérivation et tangente",
      "requires": [
        "functions.reference"
      ],
      "patterns": [
        "dériv(?:ée|er|ation)",
        "tangente"
      ]
    },
    "analysis.optimisation": {
      "label": "Optimisation par dérivation",
      "requires": [
        "analysis.derivative",
        "functions.variations"
      ],
      "patterns": []
    },
    "geometry.projection": {
      "label": "Projection orthogonale dans le plan",
      "requires": [
        "geometry.dot_product",
        "geometry.lines"
      ],
      "patterns": [
        "projeté orthogonal",
        "projection orthogonale"
      ]
    },
    "geometry.circle": {
      "label": "Cercle dans un repère",
      "requires": [
        "geometry.lines"
      ],
      "patterns": []
    },
    "probability.expectation": {
      "label": "Variable aléatoire et espérance",
      "requires": [
        "probability.elementary"
      ],
      "patterns": [
        "espérance",
        "loi de probabilité"
      ]
    },
    "probability.variance": {
      "label": "Variance d’une variable aléatoire",
      "requires": [
        "probability.expectation"
      ],
      "patterns": [
        "variance"
      ]
    },
    "functions.exponential": {
      "label": "Fonction exponentielle",
      "requires": [
        "powers.integer"
      ],
      "patterns": [
        "exponentiell",
        "\\\\exp\\b",
        "(?<![a-z])e\\^\\s*\\{?\\s*[-(]?[a-z]"
      ]
    },
    "trigonometry.radians": {
      "label": "Cercle trigonométrique et radians",
      "requires": [
        "geometry.triangle_cosine"
      ],
      "patterns": [
        "radians?",
        "angles? associés?",
        "cercle trigonométrique"
      ]
    },
    "proof.induction": {
      "label": "Raisonnement par récurrence",
      "requires": [
        "algebra.linear"
      ],
      "patterns": [
        "par récurrence",
        "hérédité",
        "initialisation"
      ]
    },
    "geometry.space_vectors": {
      "label": "Vecteurs et plans de l’espace",
      "requires": [
        "geometry.vectors"
      ],
      "patterns": [
        "plans? de l.espace",
        "repère orthonormé de l.espace"
      ]
    },
    "analysis.sequence_limit": {
      "label": "Limite d’une suite",
      "requires": [
        "sequences.geometric"
      ],
      "patterns": [
        "limite de (?:la |cette |une )?suite",
        "suite.+converg"
      ]
    },
    "analysis.function_limit": {
      "label": "Limite d’une fonction",
      "requires": [
        "functions.reference"
      ],
      "patterns": [
        "croissance comparée",
        "limite.+fonction",
        "\\\\lim\\b"
      ]
    },
    "combinatorics": {
      "label": "Dénombrement et combinatoire",
      "requires": [
        "numbers.rational",
        "powers.integer"
      ],
      "patterns": [
        "combinatoire",
        "arrangements?",
        "permutations?"
      ]
    },
    "analysis.continuity": {
      "label": "Continuité et théorème des valeurs intermédiaires",
      "requires": [
        "analysis.function_limit"
      ],
      "patterns": [
        "continuité",
        "valeurs intermédiaires",
        "\\bTVI\\b"
      ]
    },
    "analysis.convexity": {
      "label": "Convexité",
      "requires": [
        "analysis.derivative"
      ],
      "patterns": [
        "convexit",
        "convexe",
        "inflexion"
      ]
    },
    "probability.binomial": {
      "label": "Loi binomiale",
      "requires": [
        "probability.independence",
        "powers.integer"
      ],
      "patterns": [
        "binomial",
        "\\\\d?binom\\b",
        "\\\\mathcal\\s*B"
      ]
    },
    "functions.logarithm": {
      "label": "Fonction logarithme népérien",
      "requires": [
        "functions.exponential"
      ],
      "patterns": [
        "logarithme népérien",
        "\\\\ln\\b",
        "\\bln\\s*\\("
      ]
    },
    "geometry.space_orthogonality": {
      "label": "Orthogonalité et distance dans l’espace",
      "requires": [
        "geometry.space_vectors",
        "geometry.dot_product"
      ],
      "patterns": []
    },
    "analysis.primitive": {
      "label": "Primitives",
      "requires": [
        "analysis.derivative"
      ],
      "patterns": [
        "primitives?"
      ]
    },
    "analysis.differential_equation": {
      "label": "Équations différentielles",
      "requires": [
        "analysis.derivative",
        "functions.exponential"
      ],
      "patterns": [
        "équations? différentiell"
      ]
    },
    "analysis.integral": {
      "label": "Calcul intégral et aire",
      "requires": [
        "analysis.primitive"
      ],
      "patterns": [
        "intégral",
        "\\\\int\\b",
        "\\\\displaystyle\\s*\\\\int"
      ]
    },
    "analysis.integral_mean": {
      "label": "Valeur moyenne d’une fonction",
      "requires": [
        "analysis.integral"
      ],
      "patterns": [
        "(?:valeur|température) moyenne",
        "moyenne.+fonction"
      ]
    },
    "analysis.integration_by_parts": {
      "label": "Intégration par parties",
      "requires": [
        "analysis.integral",
        "analysis.derivative"
      ],
      "patterns": [
        "intégration par parties"
      ]
    },
    "probability.frequency_variance": {
      "label": "Variance d’une fréquence et concentration",
      "requires": [
        "probability.variance",
        "probability.binomial"
      ],
      "patterns": [
        "variance.+fréquence",
        "concentration",
        "grands nombres",
        "Bienaymé",
        "Tchebychev"
      ]
    },
    "geometry.parametric_space": {
      "label": "Représentations paramétriques dans l’espace",
      "requires": [
        "geometry.space_vectors"
      ],
      "patterns": [
        "représentations? paramétriques?",
        "droite paramétrée"
      ]
    },
    "trigonometry.functions": {
      "label": "Fonctions trigonométriques et dérivées",
      "requires": [
        "trigonometry.radians",
        "analysis.derivative"
      ],
      "patterns": []
    },
    "complex.algebra": {
      "label": "Nombres complexes",
      "requires": [
        "algebra.quadratic"
      ],
      "patterns": [
        "nombres? complexes?",
        "partie imaginaire",
        "\\\\mathbb\\s*\\{?C"
      ]
    },
    "complex.geometry": {
      "label": "Géométrie des nombres complexes",
      "requires": [
        "complex.algebra",
        "geometry.dot_product"
      ],
      "patterns": []
    },
    "complex.trigonometric_form": {
      "label": "Forme trigonométrique d’un complexe",
      "requires": [
        "complex.algebra",
        "trigonometry.radians"
      ],
      "patterns": []
    },
    "algebra.polynomials": {
      "label": "Équations polynomiales",
      "requires": [
        "algebra.factorisation"
      ],
      "patterns": []
    },
    "numbers.congruence": {
      "label": "Congruences",
      "requires": [
        "numbers.divisibility"
      ],
      "patterns": [
        "congruence",
        "\\\\pmod\\b"
      ]
    },
    "numbers.bezout": {
      "label": "PGCD, Bézout et Gauss",
      "requires": [
        "numbers.congruence"
      ],
      "patterns": [
        "Bézout",
        "Euclide étendu"
      ]
    },
    "numbers.fermat": {
      "label": "Nombres premiers et petit théorème de Fermat",
      "requires": [
        "numbers.congruence"
      ],
      "patterns": [
        "petit théorème de Fermat"
      ]
    },
    "algebra.matrices": {
      "label": "Matrices",
      "requires": [
        "algebra.linear"
      ],
      "patterns": [
        "matrices?"
      ]
    },
    "discrete.graphs": {
      "label": "Graphes",
      "requires": [
        "numbers.rational"
      ],
      "patterns": [
        "graphes?",
        "chaîne eulérienne"
      ]
    },
    "probability.markov": {
      "label": "Chaînes de Markov",
      "requires": [
        "algebra.matrices",
        "probability.conditional"
      ],
      "patterns": [
        "Markov",
        "matrice de transition"
      ]
    },
    "functions.decimal_log": {
      "label": "Logarithme décimal",
      "requires": [
        "powers.integer"
      ],
      "patterns": [
        "logarithme décimal",
        "\\\\log\\b"
      ]
    },
    "statistics.bivariate": {
      "label": "Statistiques à deux variables",
      "requires": [
        "statistics.univariate"
      ],
      "patterns": [
        "régression",
        "ajustement affine",
        "moindres carrés"
      ]
    }
  },
