% mx-brand.sty -- the look of the PDFs and Beamer lectures: design v7 "Bac à sable" (docs/DESIGN_V7.md).
% This is the only file of the TeX core that belongs to one site. Every other core file is structure (what a page,
% a box or a slide holds) and reads its look from the names below; units never name a colour value or a font.
% A brand file defines, in this order:
%   colours   mxink mxinktwo mxmuted mxline mxlinestrong mxpaper; mxaccent mxaccentsoft (brand, structure);
%             mxobject mxobjectfill mxobjectsoft (studied object: lines and words, fill, pale fill); mxobjtwo
%             mxobjtwosoft (second object); mxpos mxpossoft (correct); mxneg mxnegsoft (error); mxmark mxonmark (chip
%             and highlight, text on it); mxslidebg mxslideink (title slide)
%   fonts     main, sans, mono and maths faces (fontspec, files in fonts/); \mxdisplayfont (chapter and slide titles),
%             \mxheadfont (sections, box titles), \mxlabelfont (frame and chips)
%   names     \mxbrandname (plain text, PDF metadata), \mxbrandwordmark (set), \mxbrandmark{size} (the logo),
%             \mxbrandtagline (French and English, read through \mxtr)
%   pages     \mxbrandframe (header and footer of every page; uses \mxput, \mxframepage, \mxdocumentpages)
%   headings  \mxchapterlabelstyle \mxchaptertitlestyle \mxchapterrule \mxsectionstyle \mxsectionnumber{n}
%             \mxsubsectionstyle \mxsheetsectionrule
%   boxes     \mxboxtitlefont; families result, definition, method, work, quiet, pitfall, teacher as tcolorbox styles
%             mx/<family> (each sets the title colour mx@accent); mx/chip; mx/band (dark header of sessions and tests);
%             \mxarc (corner radius)
%   slides    \mxslidetitlebackground (TikZ drawing behind the title slide), \mxslidetitlefont, \mxslideframetitlemark
% The fonts are made from the site's web fonts by scripts/tex-fonts.py (list in fonts/fonts.json).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-brand}[2026/11/15 Maths Explorer brand: Bac a sable]
\providecommand{\mxcorepath}{}
\@ifpackageloaded{xcolor}{}{\RequirePackage[table]{xcolor}}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}

% ---- Colours (print: white paper; values of the Jour theme of the site) ----------------------------------------------
\definecolor{mxink}{HTML}{2B1E3F}          % plum ink
\definecolor{mxinktwo}{HTML}{4A3D5E}
\definecolor{mxmuted}{HTML}{55466B}
\definecolor{mxline}{HTML}{DCD2EA}
\definecolor{mxlinestrong}{HTML}{6A5A80}
\definecolor{mxpaper}{HTML}{FFF7EA}        % cream
\definecolor{mxaccent}{HTML}{C8391B}       % tomato, text weight
\definecolor{mxaccentsoft}{HTML}{FFF0EA}
\colorlet{mxobject}{mxaccent}              % the studied object is tomato on this site
\definecolor{mxobjectfill}{HTML}{E8492A}
\colorlet{mxobjectsoft}{mxaccentsoft}
\definecolor{mxobjtwo}{HTML}{6B4FC9}       % lilac
\definecolor{mxobjtwosoft}{HTML}{F3EEFF}
\definecolor{mxpos}{HTML}{0F7A6F}          % lagoon
\definecolor{mxpossoft}{HTML}{E2F3F0}
\definecolor{mxneg}{HTML}{A4133C}          % raspberry
\definecolor{mxnegsoft}{HTML}{FBE7EC}
\definecolor{mxmark}{HTML}{FFBE2E}         % sunflower
\colorlet{mxonmark}{mxink}
\colorlet{mxslidebg}{mxink}
\colorlet{mxslideink}{mxpaper}

% ---- Fonts -------------------------------------------------------------------------------------------------------------
% Text and labels: Atkinson Hyperlegible (made for low vision; no italic is shipped, so it is slanted). Titles:
% Bricolage Grotesque. Mathematics: STIX Two. Code: Latin Modern Mono.
\defaultfontfeatures{Path=\mxcorepath fonts/,Ligatures=TeX}
\setmainfont{AtkinsonHyperlegible}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,
  ItalicFeatures={FakeSlant=.16},BoldItalicFont=*-Bold,BoldItalicFeatures={FakeSlant=.16}]
\setsansfont{AtkinsonHyperlegible}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,
  ItalicFeatures={FakeSlant=.16},BoldItalicFont=*-Bold,BoldItalicFeatures={FakeSlant=.16}]
\setmonofont{lmmono10-regular}[Extension=.otf,UprightFont=*,ItalicFont=lmmono10-italic,BoldFont=lmmonolt10-bold,
  BoldItalicFont=lmmonolt10-boldoblique,Scale=.94]
\setmathfont{STIXTwoMath-Regular}[Extension=.otf]
\newfontfamily\mxdisplayfont{BricolageGrotesque-ExtraBold}[Extension=.ttf,BoldFont=*]
\newfontfamily\mxheadfont{BricolageGrotesque-Bold}[Extension=.ttf,BoldFont=BricolageGrotesque-ExtraBold]
\newcommand{\mxlabelfont}{\sffamily\bfseries}

% ---- Names and mark ----------------------------------------------------------------------------------------------------
\newcommand{\mxbrandname}{Maths Explorer}
\newcommand{\mxbrandwordmark}{{\mxdisplayfont maths\ \textcolor{mxaccent}{explorer}}}
% The mark: a Reuleaux triangle (constant width) with a dot. \mxbrandmark[fill][dot]{height}; below 5 mm the dot is
% dropped. Drawn on the 100-unit grid of the site's SVG (y turned up).
\newlength{\mx@u}
\NewDocumentCommand{\mxbrandmark}{O{mxobjectfill} O{white} m}{\setlength{\mx@u}{#3}\divide\mx@u by 100\relax
  \begin{tikzpicture}[baseline={(0,22.2\mx@u)}]
  \fill[#1] (50\mx@u,88\mx@u) arc[start angle=60,end angle=0,radius=76\mx@u] arc[start angle=-60,end angle=-120,radius=76\mx@u]
    arc[start angle=180,end angle=120,radius=76\mx@u] -- cycle;
  \ifdim#3>5mm\fill[#2] (50\mx@u,44\mx@u) circle[radius=9\mx@u];\fi
\end{tikzpicture}}
\newcommand{\mxbrandtagline}{\mxtr{Devine, compare, prouve.}{Guess, compare, prove.}}

% ---- Page frame --------------------------------------------------------------------------------------------------------
% Header: the mark and the wordmark, the language at the right, a 1.2 pt ink rule. Footer: a hairline, the tagline and
% the page count. Rounded shapes, no fill, no shadow.
\newcommand{\mxbrandframe}{%
  \AtPageUpperLeft{%
    \mxput{23bp}{-29.6bp}{\mxbrandmark{10.5bp}}%
    \mxput{36.5bp}{-28.6bp}{\makebox(0,0)[lb]{\fontsize{8.4bp}{10bp}\selectfont\color{mxink}\mxbrandwordmark}}%
    \mxput{\dimexpr\paperwidth-23bp-5.2em\relax}{-28.4bp}{\makebox(0,0)[lb]{\mxlabelfont\fontsize{7.4bp}{9bp}\selectfont\color{mxmuted}\mxtr{FR}{EN}}}%
    \mxput{23bp}{-34bp}{\color{mxink}\rule{\dimexpr\paperwidth-46bp\relax}{1.2bp}}}%
  \AtPageLowerLeft{%
    \mxput{23bp}{26.75bp}{\color{mxline}\rule{\dimexpr\paperwidth-46bp\relax}{.6bp}}%
    \mxput{23bp}{14bp}{\makebox(0,0)[lb]{\sffamily\fontsize{7.4bp}{9bp}\selectfont\color{mxmuted}\mxbrandtagline}}%
    \mxput{\dimexpr\paperwidth-23bp-3.4em\relax}{14bp}{\makebox(0,0)[lb]{\sffamily\bfseries\fontsize{7.4bp}{9bp}\selectfont\color{mxink}\mxframepage\ \textcolor{mxmuted}{/ \mxdocumentpages}}}}}

% ---- Headings ----------------------------------------------------------------------------------------------------------
\newcommand{\mxchapterlabelstyle}{\mxlabelfont\small\color{mxaccent}}
\newcommand{\mxchaptertitlestyle}{\mxdisplayfont\fontsize{27}{29}\selectfont\color{mxink}}
\newcommand{\mxchapterrule}{\vspace{8pt}\noindent\begin{tikzpicture}\fill[mxobjectfill,rounded corners=1.6pt] (0,0) rectangle (24mm,3.2pt);\end{tikzpicture}}
\newcommand{\mxsectionstyle}{\mxheadfont\Large\color{mxink}}
\newcommand{\mxsectionnumber}[1]{\textcolor{mxaccent}{#1}}
\newcommand{\mxsubsectionstyle}{\mxheadfont\large\color{mxink}}
\newcommand{\mxsheetsectionrule}{\vspace{-2pt}{\color{mxline}\titlerule[.8pt]}}

% ---- Boxes -------------------------------------------------------------------------------------------------------------
% Rounded cards (12 px on the site: 3 mm here). Definitions on a lilac card, properties outlined in ink with a tomato
% title, work boxes outlined lightly, errors on a raspberry card, teacher material on a lagoon card.
\newcommand{\mxarc}{3mm}
\newcommand{\mxboxtitlefont}{\mxheadfont}
\tcbset{
  mx/base/.style={enhanced,breakable,parbox=false,arc=\mxarc,outer arc=\mxarc,boxrule=0pt,colframe=white,colback=white,
    left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=7pt,after skip=5pt,fontupper=\normalfont},
  mx/result/.style={mx/base,boxrule=1pt,colframe=mxink,code={\colorlet{mx@accent}{mxaccent}}},
  mx/definition/.style={mx/base,colback=mxobjtwosoft,code={\colorlet{mx@accent}{mxobjtwo}}},
  mx/method/.style={mx/base,colback=mxpaper,code={\colorlet{mx@accent}{mxink}}},
  mx/work/.style={mx/base,boxrule=.8pt,colframe=mxline,code={\colorlet{mx@accent}{mxink}}},
  mx/quiet/.style={mx/base,colback=mxpaper,code={\colorlet{mx@accent}{mxinktwo}}},
  mx/pitfall/.style={mx/base,colback=mxnegsoft,code={\colorlet{mx@accent}{mxneg}}},
  mx/teacher/.style={mx/base,colback=mxpossoft,code={\colorlet{mx@accent}{mxpos}}},
  mx/chip/.style={on line,colback=mxmark,colframe=mxmark,coltext=mxonmark,boxrule=0pt,arc=5pt,
    left=4pt,right=4pt,top=1pt,bottom=1pt,fontupper=\sffamily\bfseries\scriptsize},
  mx/band/.style={enhanced,colback=mxink,colframe=mxink,boxrule=0pt,arc=\mxarc,coltext=mxpaper},
}

% ---- Slides (Beamer theme mx) ------------------------------------------------------------------------------------------
% Title slide: plum page, cream text, a large tomato Reuleaux triangle rolling off the right edge.
\newcommand{\mxslidetitlebackground}{\begin{tikzpicture}[remember picture,overlay]
  \fill[mxslidebg] (current page.south west) rectangle (current page.north east);
  \node[anchor=center] at ([xshift=-14mm,yshift=4mm]current page.east) {\mxbrandmark[mxobjectfill][mxobjectfill]{58mm}};
\end{tikzpicture}}
% Face of the title on the title slide: the display face.
\newcommand{\mxslidetitlefont}{\mxdisplayfont}
% The mark before a frame title: a short rounded tomato bar.
\newcommand{\mxslideframetitlemark}{\begin{tikzpicture}\fill[mxobjectfill,rounded corners=1.3pt] (0,0) rectangle (1.6em,2.6pt);\end{tikzpicture}}
