% mx-brand.sty -- the look of the PDFs and Beamer lectures: design v8 "Bande dessinée" (docs/DESIGN_V8.md).
% This is the only file of the TeX core that belongs to one site. Every other core file is structure (what a page,
% a box or a slide holds) and reads its look from the names below; units never name a colour value or a font.
% A brand file defines, in this order:
%   colours   mxink mxinktwo mxmuted mxline mxlinestrong mxpaper; mxaccent mxaccentsoft (brand, structure);
%             mxobject mxobjectfill mxobjectsoft (studied object: lines and words, fill, pale fill); mxobjtwo
%             mxobjtwosoft (second object); mxpos mxpossoft (correct); mxneg mxnegsoft (error); mxmark mxonmark (chip
%             and highlight, text on it); mxslidebg mxslideink (title slide)
%   fonts     main, sans, mono and maths faces (fontspec, files in fonts/); \mxdisplayfont (chapter and slide titles),
%             \mxheadfont (sections, box titles), \mxlabelfont (frame and chips)
%   names     \mxbrandname (plain text, PDF metadata), \mxbrandwordmark (set), \mxbrandmark{size} (the logo),
%             \mxbrandtagline (French and English, read through \mxtr)
%   pages     \mxbrandframe (header and footer of every page; uses \mxput, \mxframepage, \mxdocumentpages)
%   headings  \mxchapterlabelstyle \mxchaptertitlestyle \mxchapterrule \mxsectionstyle \mxsectionnumber{n}
%             \mxsubsectionstyle \mxsheetsectionrule
%   boxes     \mxboxtitlefont; families result, definition, method, work, quiet, pitfall, teacher as tcolorbox styles
%             mx/<family> (each sets the title colour mx@accent); mx/chip; mx/band (dark header of sessions and tests);
%             \mxarc (corner radius)
%   slides    \mxslidetitlebackground (TikZ drawing behind the title slide), \mxslidetitlefont, \mxslideframetitlemark
% The fonts are made from the site's web fonts by scripts/tex-fonts.py (list in fonts/fonts.json).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-brand}[2026/11/18 Maths Explorer brand: Bande dessinee]
\providecommand{\mxcorepath}{}
\@ifpackageloaded{xcolor}{}{\RequirePackage[table]{xcolor}}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}

% ---- Colours (print: white paper; the comic palette of the site, values of the Jour theme) ----------------------------------
\definecolor{mxink}{HTML}{111111}          % ink
\definecolor{mxinktwo}{HTML}{2B2B2B}
\definecolor{mxmuted}{HTML}{3D3D3D}
\definecolor{mxline}{HTML}{BDBDBD}
\definecolor{mxlinestrong}{HTML}{111111}
\definecolor{mxpaper}{HTML}{FFF6C2}        % pale comic yellow
\definecolor{mxaccent}{HTML}{B3101D}       % comic red, text weight
\definecolor{mxaccentsoft}{HTML}{FFE1E3}
\colorlet{mxobject}{mxaccent}              % the studied object is red on this site
\definecolor{mxobjectfill}{HTML}{E11D2E}
\colorlet{mxobjectsoft}{mxaccentsoft}
\definecolor{mxobjtwo}{HTML}{1D4ED8}       % comic blue
\definecolor{mxobjtwosoft}{HTML}{E6EDFF}
\definecolor{mxpos}{HTML}{0A6B34}
\definecolor{mxpossoft}{HTML}{DCF5E5}
\definecolor{mxneg}{HTML}{9B0D4F}
\definecolor{mxnegsoft}{HTML}{FDE3EE}
\definecolor{mxmark}{HTML}{FFE14D}         % comic yellow
\colorlet{mxonmark}{mxink}
\colorlet{mxslidebg}{mxmark}
\colorlet{mxslideink}{mxink}

% ---- Fonts -------------------------------------------------------------------------------------------------------------
% Text and labels: Comic Neue (lettering, with its own italic). Titles: Anton (the open face closest to Impact, which the
% site uses when the reader has it). Mathematics: STIX Two. Code: Latin Modern Mono.
\defaultfontfeatures{Path=\mxcorepath fonts/,Ligatures=TeX}
\setmainfont{ComicNeue}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]
\setsansfont{ComicNeue}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]
\setmonofont{lmmono10-regular}[Extension=.otf,UprightFont=*,ItalicFont=lmmono10-italic,BoldFont=lmmonolt10-bold,
  BoldItalicFont=lmmonolt10-boldoblique,Scale=.94]
\setmathfont{STIXTwoMath-Regular}[Extension=.otf]
\newfontfamily\mxdisplayfont{Anton-Regular}[Extension=.ttf,BoldFont=*,LetterSpace=1.5]
\newfontfamily\mxheadfont{Anton-Regular}[Extension=.ttf,BoldFont=*,LetterSpace=1]
\newcommand{\mxlabelfont}{\sffamily\bfseries}

% ---- Names and mark ----------------------------------------------------------------------------------------------------
\newcommand{\mxbrandname}{Maths Explorer}
\newcommand{\mxbrandwordmark}{{\mxdisplayfont MATHS\ \textcolor{mxaccent}{EXPLORER}}}
% The mark: a comic starburst outlined in ink, with a white pi. \mxbrandmark[fill][pi]{height}; below 5 mm the pi is
% dropped. Twelve points with a fixed irregularity, as on the site (site/js/app.js brandMark).
\newlength{\mx@u}
\NewDocumentCommand{\mxbrandmark}{O{mxobjectfill} O{white} m}{\setlength{\mx@u}{#3}\divide\mx@u by 100\relax
  \begin{tikzpicture}[baseline={(0,30\mx@u)}]
  \draw[fill=#1,draw=mxink,line width=5\mx@u,line join=round]
    (90:48\mx@u) -- (105:34\mx@u) -- (120:43\mx@u) -- (135:34\mx@u) -- (150:49\mx@u) -- (165:34\mx@u) -- (180:42\mx@u)
    -- (195:34\mx@u) -- (210:48\mx@u) -- (225:34\mx@u) -- (240:44\mx@u) -- (255:34\mx@u) -- (270:47\mx@u) -- (285:34\mx@u)
    -- (300:43\mx@u) -- (315:34\mx@u) -- (330:48\mx@u) -- (345:34\mx@u) -- (0:42\mx@u) -- (15:34\mx@u) -- (30:47\mx@u)
    -- (45:34\mx@u) -- (60:44\mx@u) -- (75:34\mx@u) -- cycle;
  \ifdim#3>5mm\node[text=#2,font=\mxdisplayfont\fontsize{38\mx@u}{38\mx@u}\selectfont,inner sep=0pt] at (0,-2\mx@u) {$\symup{\pi}$};\fi
\end{tikzpicture}}
\newcommand{\mxbrandtagline}{\mxtr{Touche, devine, puis prouve.}{Touch, guess, then prove.}}

% ---- Page frame --------------------------------------------------------------------------------------------------------
% Header: the mark and the wordmark, the language at the right, a 2 pt ink rule. Footer: a hairline, the tagline and
% the page count in a small ink box. Square corners; the only fill is the mark.
\newcommand{\mxbrandframe}{%
  \AtPageUpperLeft{%
    \mxput{23bp}{-30.6bp}{\mxbrandmark{12bp}}%
    \mxput{38bp}{-28.6bp}{\makebox(0,0)[lb]{\fontsize{9bp}{10bp}\selectfont\color{mxink}\mxbrandwordmark}}%
    \mxput{\dimexpr\paperwidth-23bp-5.2em\relax}{-28.4bp}{\makebox(0,0)[lb]{\mxlabelfont\fontsize{7.4bp}{9bp}\selectfont\color{mxmuted}\mxtr{FR}{EN}}}%
    \mxput{23bp}{-35bp}{\color{mxink}\rule{\dimexpr\paperwidth-46bp\relax}{2bp}}}%
  \AtPageLowerLeft{%
    \mxput{23bp}{26.75bp}{\color{mxink}\rule{\dimexpr\paperwidth-46bp\relax}{.8bp}}%
    \mxput{23bp}{14bp}{\makebox(0,0)[lb]{\sffamily\bfseries\fontsize{7.4bp}{9bp}\selectfont\color{mxmuted}\mxbrandtagline}}%
    \mxput{\dimexpr\paperwidth-23bp-3.4em\relax}{14bp}{\makebox(0,0)[lb]{\sffamily\bfseries\fontsize{7.4bp}{9bp}\selectfont\color{mxink}\mxframepage\ \textcolor{mxmuted}{/ \mxdocumentpages}}}}}

% ---- Headings ----------------------------------------------------------------------------------------------------------
\newcommand{\mxchapterlabelstyle}{\mxlabelfont\small\color{mxaccent}}
\newcommand{\mxchaptertitlestyle}{\mxdisplayfont\fontsize{30}{32}\selectfont\color{mxink}}
\newcommand{\mxchapterrule}{\vspace{8pt}\noindent\begin{tikzpicture}
  \fill[mxink] (1.2pt,-1.2pt) rectangle (30mm+1.2pt,4.4pt-1.2pt);
  \draw[fill=mxobjectfill,draw=mxink,line width=1pt] (0,0) rectangle (30mm,4.4pt);\end{tikzpicture}}
\newcommand{\mxsectionstyle}{\mxheadfont\Large\color{mxink}}
\newcommand{\mxsectionnumber}[1]{\textcolor{mxaccent}{#1}}
\newcommand{\mxsubsectionstyle}{\mxheadfont\large\color{mxink}}
\newcommand{\mxsheetsectionrule}{\vspace{-2pt}{\color{mxink}\titlerule[1pt]}}

% ---- Boxes -------------------------------------------------------------------------------------------------------------
% Comic panels: square corners, an ink outline and a solid offset shadow. Properties are white panels with a red title,
% definitions are blue panels, methods sit on pale yellow, errors on a raspberry panel, teacher material on green.
\newcommand{\mxarc}{0mm}
\newcommand{\mxboxtitlefont}{\mxheadfont}
\tcbset{
  mx/base/.style={enhanced,breakable,parbox=false,sharp corners,arc=\mxarc,outer arc=\mxarc,boxrule=0pt,colframe=white,colback=white,
    left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=8pt,after skip=7pt,fontupper=\normalfont},
  mx/panel/.style={mx/base,boxrule=1pt,colframe=mxink,
    shadow={1.4mm}{-1.4mm}{0mm}{mxink}},
  mx/result/.style={mx/panel,code={\colorlet{mx@accent}{mxaccent}}},
  mx/definition/.style={mx/panel,colframe=mxobjtwo,colback=mxobjtwosoft,shadow={1.4mm}{-1.4mm}{0mm}{mxobjtwo},code={\colorlet{mx@accent}{mxobjtwo}}},
  mx/method/.style={mx/panel,colback=mxpaper,code={\colorlet{mx@accent}{mxink}}},
  mx/work/.style={mx/base,boxrule=.8pt,colframe=mxink,code={\colorlet{mx@accent}{mxink}}},
  mx/quiet/.style={mx/base,colback=mxpaper,code={\colorlet{mx@accent}{mxinktwo}}},
  mx/pitfall/.style={mx/panel,colframe=mxneg,colback=mxnegsoft,shadow={1.4mm}{-1.4mm}{0mm}{mxneg},code={\colorlet{mx@accent}{mxneg}}},
  mx/teacher/.style={mx/panel,colframe=mxpos,colback=mxpossoft,shadow={1.4mm}{-1.4mm}{0mm}{mxpos},code={\colorlet{mx@accent}{mxpos}}},
  mx/chip/.style={on line,colback=mxmark,colframe=mxink,coltext=mxonmark,boxrule=.6pt,arc=0pt,sharp corners,
    left=4pt,right=4pt,top=1pt,bottom=1pt,fontupper=\sffamily\bfseries\scriptsize},
  mx/band/.style={enhanced,sharp corners,colback=mxink,colframe=mxink,boxrule=0pt,arc=\mxarc,coltext=white},
}

% ---- Slides (Beamer theme mx) ------------------------------------------------------------------------------------------
% Title slide: a halftone yellow page with a large red starburst breaking out of the right edge.
\newcommand{\mxslidetitlebackground}{\begin{tikzpicture}[remember picture,overlay]
  \fill[mxslidebg] (current page.south west) rectangle (current page.north east);
  \begin{scope}[shift={(current page.south west)}]
    \foreach \i in {0,...,63}{\foreach \j in {0,...,36}{\fill[mxobjectfill,opacity=.16] (\i*2.6mm+1.3mm,\j*2.6mm+1.3mm) circle[radius=.42mm];}}
  \end{scope}
  \node[anchor=center] at ([xshift=-10mm,yshift=4mm]current page.east) {\mxbrandmark[mxobjectfill][white]{62mm}};
\end{tikzpicture}}
% Face of the title on the title slide: the display face.
\newcommand{\mxslidetitlefont}{\mxdisplayfont}
% The mark before a frame title: a short red bar outlined in ink.
\newcommand{\mxslideframetitlemark}{\begin{tikzpicture}\fill[mxink] (.9pt,-.9pt) rectangle (1.6em+.9pt,3.2pt-.9pt);\draw[fill=mxobjectfill,draw=mxink,line width=.6pt] (0,0) rectangle (1.6em,3.2pt);\end{tikzpicture}}
