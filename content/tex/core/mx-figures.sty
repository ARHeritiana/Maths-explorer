% mx-figures.sty -- TikZ and pgfplots styles, and the colour names units use in figures. No colour value is written
% here: every colour is a role defined by the brand (mx-brand.sty), so the same units print in each site's look.
% Roles: mxobject = the studied object (lines and words), mxobjectfill / mxobjectsoft = its fills, mxobjtwo = a second
% object, mxpos = correct (teacher answers), mxneg = error or warning, mxink / mxmuted / mxline = drawing ink and grid.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-figures}[2026/11/15 Maths Explorer figures]
\RequirePackage{mx-brand}
% Names used by the units and older styles keep working: mint = the studied object, teacher = what is correct,
% warn = a warning.
\colorlet{mxmint}{mxobject}
\colorlet{mxmintpale}{mxobjectsoft}
\colorlet{mxteacher}{mxpos}
\colorlet{mxwarn}{mxneg}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,patterns,decorations.pathreplacing,trees,shapes.geometric,angles,quotes,3d}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\tikzset{mxcurve/.style={mxobject,thick}, mxaux/.style={mxmuted,dashed}, mxpoint/.style={circle,fill=mxink,inner sep=1.3pt}, mxaxisline/.style={->,mxmuted}}
\pgfplotsset{mxaxis/.style={axis lines=middle,grid=major,grid style={mxline},tick label style={font=\footnotesize},
  every axis plot/.append style={thick}}}
% Square-grid axes for function graphs (former Seconde style "coursaxe").
\pgfplotsset{mxgridaxis/.style={axis lines=middle,grid=both,minor tick num=1,width=11cm,height=7cm,xlabel={$x$},
  ylabel={$y$},tick label style={font=\small},samples=100}}
