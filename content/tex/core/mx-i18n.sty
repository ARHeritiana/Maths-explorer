% mx-i18n.sty -- language-dependent labels, dates and conventions, from one dictionary keyed by language.
% Content units never test the language; they use the labels and macros below. English units are generated from
% French ones (docs/ADR-0001-tex-i18n.md); numbers, intervals and points are written with mx-notation.sty commands.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-i18n}[2026/10/11 Maths Explorer i18n]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\def\mx@fr{fr}
\ifx\mx@lang\mx@fr
  \RequirePackage[french]{babel}
  % Sources write French spacing by hand (x\,; or x~:); babel adds a space only where the source typed one.
  \frenchsetup{SmallCapsFigTabCaptions=false,AutoSpacePunctuation=false,StandardLists=true,ReduceListSpacing=false}
\else
  \RequirePackage[english]{babel}
\fi
% Name before a unit number in booklets: Chapitre/Chapter, or Séquence/Sequence (class option unit=sequence).
\AtBeginDocument{\def\mx@seq{sequence}\ifx\mx@unitname\mx@seq\renewcommand{\chaptername}{\mxlabelof{sequence}}\fi}
% Same inter-sentence spacing in both languages, so French and English line breaks stay comparable.
\AtBeginDocument{\frenchspacing}

% \mxtr{french}{english}: pick the text for the current language. Allowed in core packages only, never in units.
\newcommand{\mxtr}[2]{\ifx\mx@lang\mx@fr #1\else #2\fi}

% Label dictionary: \mxlabelof{key} prints the displayed name of an environment or element.
\newcommand{\mx@deflabel}[3]{\expandafter\def\csname mx@label@#1\endcsname{\mxtr{#2}{#3}}}
\newcommand{\mxlabelof}[1]{\csname mx@label@#1\endcsname}
