% \mxdate{YYYY-MM-DD}: a date in the reader's language ("15 septembre 2026" / "15 September 2026");
% \mxdate*{YYYY-MM-DD}: short form ("15/09/2026" / "15 Sep 2026").
\def\mx@monthfr#1{\ifcase#1\or janvier\or février\or mars\or avril\or mai\or juin\or juillet\or août\or septembre\or octobre\or novembre\or décembre\fi}
\def\mx@monthen#1{\ifcase#1\or January\or February\or March\or April\or May\or June\or July\or August\or September\or October\or November\or December\fi}
\def\mx@monthenshort#1{\ifcase#1\or Jan\or Feb\or Mar\or Apr\or May\or Jun\or Jul\or Aug\or Sep\or Oct\or Nov\or Dec\fi}
\def\mx@date#1-#2-#3\relax{\mxtr{\number#3\ifnum#3=1 \textsuperscript{er}\fi\ \mx@monthfr{#2} #1}{\number#3\ \mx@monthen{#2} #1}}
\def\mx@shortdate#1-#2-#3\relax{\mxtr{#3/#2/#1}{\number#3\ \mx@monthenshort{#2} #1}}
\NewDocumentCommand{\mxdate}{s m}{\IfBooleanTF{#1}{\mx@shortdate#2\relax}{\mx@date#2\relax}}
