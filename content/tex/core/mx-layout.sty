% mx-layout.sty -- page geometry, headings, running heads and the page-break policy.
% Page breaks: units never use \clearpage or \newpage (a lint enforces it). Boxes and headings reserve space with
% \Needspace; chapters start on a new page through the class.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-layout}[2026/10/11 Maths Explorer layout]
\RequirePackage{geometry,fancyhdr,titlesec,needspace,microtype,enumitem,booktabs,array,tabularx,longtable,multicol}
\def\mx@booklet{booklet}\def\mx@figs{slide-figs}
\ifx\mx@layout\mx@booklet
  \geometry{a4paper,inner=24mm,outer=19mm,top=21mm,bottom=22mm,headheight=15pt}
\else\ifx\mx@layout\mx@figs
  \geometry{paperwidth=16cm,paperheight=9cm,margin=4mm}\pagestyle{empty}
\else
  \geometry{a4paper,left=19mm,right=19mm,top=17mm,bottom=17mm,headheight=14pt}
\fi\fi
\ifx\mx@layout\mx@booklet\else\renewcommand{\thesection}{\arabic{section}}\fi   % no chapters outside booklets
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt plus 1pt}
\renewcommand{\familydefault}{\rmdefault}
\titleformat{\chapter}[display]{\sffamily\bfseries\color{mxink}}{\large\color{mxmint}\MakeUppercase{\chaptername}~\thechapter}{4pt}{\huge}[{\color{mxmint}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{14pt}
\titleformat{\section}{\needspace{5\baselineskip}\Large\sffamily\bfseries\color{mxink}}{\thesection}{.7em}{}
\titleformat{\subsection}{\needspace{4\baselineskip}\large\sffamily\bfseries\color{mxink}}{\thesubsection}{.6em}{}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{.3pt}
\fancyhead[LE,RO]{\small\sffamily\color{mxmuted}\leftmark}
\fancyfoot[LE,RO]{\small\sffamily\bfseries\thepage}
\fancyfoot[RE,LO]{\small\sffamily\color{mxmuted}\ifmxteacher\mxlabelof{teacher}\else\mxlabelof{student}\fi}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[LE,RO]{\small\sffamily\bfseries\thepage}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
% \mxneed{n}: keep the next n lines together (reserve space or start a new page).
\newcommand{\mxneed}[1]{\Needspace{#1\baselineskip}}

% Sheet layout (no chapters): the table of contents stays on the current page, the running head shows the current
% section and the edition.
\ifx\mx@layout\mx@booklet\else
  \makeatletter
  \renewcommand{\tableofcontents}{\section*{\contentsname}\@starttoc{toc}}
  \makeatother
  \setlength{\parskip}{0pt}
  \titleformat{\section}{\needspace{5\baselineskip}\Large\sffamily\bfseries\color{mxink}}{\thesection}{.7em}{}[\vspace{-2pt}{\color{mxline}\titlerule}]
  \titlespacing*{\section}{0pt}{12pt}{6pt}
  % ragged right, hyphenation strongly discouraged: short items, line counts close between French and English
  \AtBeginDocument{\raggedright\hyphenpenalty=2000\exhyphenpenalty=2000}
  \fancyhf{}
  \fancyhead[L]{\small\sffamily\color{mxmuted}\rightmark}
  \fancyhead[R]{\small\sffamily\color{mxmuted}\ifmxteacher\mxlabelof{teacher}\else\mxlabelof{student}\fi}
  \fancyfoot[C]{\small\sffamily\thepage}
  \renewcommand{\sectionmark}[1]{\markright{#1}}
  \fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\sffamily\thepage}}
\fi
