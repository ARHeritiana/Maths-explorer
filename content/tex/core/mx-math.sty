% mx-math.sty -- every mathematics macro that reads the same in both languages, defined once. Notations that differ
% between French and English (numbers, intervals, points, sets) are in mx-notation.sty. The slide player's MathJax
% macro table is generated from the \mxmathmacro lines below (`python -m mxbuild notation`), so a macro used in a
% slide must be declared here.
% Syntax: \mxmathmacro{\name}{nargs}{body} defines the LaTeX macro and records it for MathJax.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-math}[2026/10/11 Maths Explorer mathematics]
\RequirePackage{amsmath,mathtools}
% Portable profile: XeTeX (or LuaTeX), OpenType fonts shipped in core/fonts and loaded by file name, so nothing depends on
% the fonts of the machine that compiles. Text and maths: STIX Two. Headings and labels: Schibsted Grotesk (the site's
% display face). Code: Latin Modern Mono. \mxcorepath is the folder of the core relative to the main file (set by the
% generated mains; empty when the main sits beside the core).
\providecommand{\mxcorepath}{}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\defaultfontfeatures{Path=\mxcorepath fonts/,Ligatures=TeX}
\setmainfont{STIXTwoText}[Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-Bold,BoldItalicFont=*-BoldItalic]
\setsansfont{SchibstedGrotesk}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,
  ItalicFeatures={FakeSlant=.17},BoldItalicFont=*-Bold,BoldItalicFeatures={FakeSlant=.17}]
\setmonofont{lmmono10-regular}[Extension=.otf,UprightFont=*,ItalicFont=lmmono10-italic,BoldFont=lmmonolt10-bold,
  BoldItalicFont=lmmonolt10-boldoblique,Scale=.94]
\setmathfont{STIXTwoMath-Regular}[Extension=.otf]
\newfontface\mxsemibold{SchibstedGrotesk-SemiBold}[Extension=.ttf]
% amssymb names that unicode-math leaves undefined or maps to an error.
\def\square{\mdlgwhtsquare}
\def\llbracket{\lBrack}\def\rrbracket{\rBrack}   % integer intervals (stmaryrd names)
\newcommand{\mxmathmacro}[3]{\ifx0#2\newcommand{#1}{#3}\else\newcommand{#1}[#2]{#3}\fi}
% \mxmathoverride: same, for a name a loaded package already defines (listed conflicts only; others must error).
\makeatletter
\newcommand{\mxmathoverride}[3]{\let#1\@undefined\mxmathmacro{#1}{#2}{#3}}
\makeatother
% Number sets
\mxmathmacro{\N}{0}{\mathbb{N}}
\mxmathmacro{\Z}{0}{\mathbb{Z}}
\mxmathmacro{\D}{0}{\mathbb{D}}
\mxmathmacro{\Q}{0}{\mathbb{Q}}
\mxmathmacro{\R}{0}{\mathbb{R}}
\mxmathmacro{\C}{0}{\mathbb{C}}
% Vectors and geometry
\mxmathmacro{\vect}{1}{\overrightarrow{#1}}
\mxmathmacro{\vi}{0}{\vec{\imath}}
\mxmathmacro{\vj}{0}{\vec{\jmath}}
\mxmathmacro{\vk}{0}{\vec{k}}
\mxmathmacro{\norm}{1}{\left\lVert #1\right\rVert}
\mxmathmacro{\vc}{2}{\begin{pmatrix}#1\\#2\end{pmatrix}}          % column vector (x ; y)
\mxmathmacro{\deter}{2}{\det\left(#1,#2\right)}
% Analysis and arithmetic
\mxmathmacro{\abs}{1}{\left\lvert #1\right\rvert}
\mxmathmacro{\dd}{0}{\,\mathrm{d}}                                % differential: \int f(x)\dd x
\mxmathmacro{\e}{0}{\mathrm{e}}
\mxmathmacro{\Card}{0}{\operatorname{Card}}
\mxmathmacro{\E}{0}{\operatorname{E}}                            % expectation
\mxmathmacro{\V}{0}{\operatorname{V}}                            % variance
\mxmathmacro{\pgcd}{0}{\operatorname{\mxtr{PGCD}{gcd}}}   % operator names follow the language
\mxmathmacro{\ppcm}{0}{\operatorname{\mxtr{PPCM}{lcm}}}
\mxmathoverride{\degre}{0}{^{\circ}}          % babel-french defines a text \degre; ours is for maths
\mxmathmacro{\un}{1}{\,\mathrm{#1}}                               % unit after a number: 3\un{cm}
\mxmathmacro{\sci}{2}{#1\times10^{#2}}                            % scientific notation
