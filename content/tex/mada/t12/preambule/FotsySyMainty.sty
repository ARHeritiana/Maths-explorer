\providecommand{\exclamation}{% We provide the command first. If the smiley package is already loaded this command doesn't apply.
	\begin{tikzpicture}[scale=.035ex]
	\clip (-1.6,-1.35) rectangle (1.6,1.5) ;
	\filldraw[draw=gray!50!black,line width=.2ex,smooth,rounded corners=.1em] (-1.566,-1.2) -- (1.566,-1.2) -- (0,1.5) -- cycle;
