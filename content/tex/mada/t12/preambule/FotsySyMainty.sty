\newcommand{\warning}[1]{
	\begin{frame}
		\if@twocolumn
		      \setlength{\pict}{4.5\baselineskip}
		      \setlength{\boxlen}{0.475\textwidth}
		      \setlength{\ligne}{\boxlen-\pict}
		\else
		      \setlength{\pict}{4.5\baselineskip}
		      \setlength{\boxlen}{\textwidth-4ex}
		      \setlength{\ligne}{\boxlen-\pict}
		\fi
		%
		~\newline
		\noindent
		\shadowbox{%
		      \parbox{\boxlen}{%
		      \vspace{.25\baselineskip}
		            \makebox{{\fontsize{2.5\baselineskip}{2.5\baselineskip} \selectfont \exclamation}}
		            \vspace{-3\baselineskip}\\
		                  \begin{minipage}{\ligne}
		                        \raggedright
		                        \parshape=4    % This command shapes the paragraph to the wished form: ie
		                        \pict \ligne   % Those are the form of the paragraph: the indentation and then the length of a line.
		                        \pict \ligne   % --------------------------------------- || ---------------------------------------
		                        \pict \ligne   % --------------------------------------- || ---------------------------------------
		                        0pt \boxlen    % And then, back to normal: 0 indentation and a full lenghth line.
		                              \WarningFont{%
		                                          \raggedright%
		                                    #1%
		                               }%
		                  \end{minipage}
		            }
		      }
		\vspace{-1\baselineskip}
	\end{frame}
}
