{
  "about": "Faces the TeX core loads, made from site/fonts by scripts/tex-fonts.py (brand: Bande dessinée). STIX Two and Latin Modern Mono are shipped as they are.",
  "faces": {
    "ComicNeue-Regular.ttf": {
      "family": "Comic Neue",
      "style": "Regular",
      "sources": [
        "comic-neue-latin-400-normal.woff2"
      ],
      "fallback": "STIXTwoText-Regular.otf"
    },
    "ComicNeue-Bold.ttf": {
      "family": "Comic Neue Bold",
      "style": "Regular",
      "sources": [
        "comic-neue-latin-700-normal.woff2"
      ],
      "fallback": "STIXTwoText-Bold.otf"
    },
    "ComicNeue-Italic.ttf": {
      "family": "Comic Neue Italic",
      "style": "Regular",
      "sources": [
        "comic-neue-latin-400-italic.woff2"
      ],
      "fallback": "STIXTwoText-Italic.otf"
    },
    "ComicNeue-BoldItalic.ttf": {
      "family": "Comic Neue Bold Italic",
      "style": "Regular",
      "sources": [
        "comic-neue-latin-700-italic.woff2"
      ],
      "fallback": "STIXTwoText-BoldItalic.otf"
    },
    "Anton-Regular.ttf": {
      "family": "Anton",
      "style": "Regular",
      "sources": [
        "anton-latin-400-normal.woff2",
        "anton-latin-ext-400-normal.woff2"
      ],
      "fallback": "STIXTwoText-Bold.otf"
    }
  }
}
