% mx-code.sty -- Python listings, one style for every course.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-code}[2026/10/11 Maths Explorer code]
\RequirePackage{listings}
\lstdefinestyle{mxpython}{language=Python,basicstyle=\ttfamily\small,keywordstyle=\color{mxmint}\bfseries,
  commentstyle=\color{mxmuted}\itshape,stringstyle=\color{mxwarn},showstringspaces=false,columns=fullflexible,
  keepspaces=true,frame=leftline,framerule=1.2pt,rulecolor=\color{mxline},xleftmargin=1em,breaklines=true,
  literate={é}{{\'e}}1 {è}{{\`e}}1 {à}{{\`a}}1 {ç}{{\c{c}}}1 {ê}{{\^e}}1 {ô}{{\^o}}1 {É}{{\'E}}1}
\lstset{style=mxpython}
\lstdefinestyle{python}{style=mxpython}   % name used by older units
% \code{text}: inline code, verbatim-safe for underscores and braces.
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}
