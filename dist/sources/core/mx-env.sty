% mx-env.sty -- canonical environments, identical in every course. Names are English keys; the displayed label comes
% from mx-i18n (\mxlabelof). Large boxes: mdframed, left rule, breakable. Small elements: tcolorbox.
% Numbered: example, exercise, activity (per chapter, \newcounter). Teacher-only: solution, teachernote.
%
%   \begin{keypoint}[title] ... \end{keypoint}       also definition, theorem, method, example, pitfall, activity,
%   \begin{exercise}[title] ... \end{exercise}            exercise, application, homework, exitticket, fluency,
%   \begin{proof} ... \end{proof}                         objectives, prerequisites
%   \begin{solution} ... \end{solution}               teacher edition only
%   \begin{teachernote}[title] ... \end{teachernote}  teacher edition only
%   \begin{figurebox}[caption] ... \end{figurebox}    centred figure with an optional caption
%   \mxanswer{text}          answer shown in the teacher edition, nothing in the student edition
%   \mxblank{text}           dotted blank for students, the text in bold for teachers
%   \mxlines{n}              n ruled answer lines, student edition only
%   \mxchip{text}            small rounded label (duration, difficulty)
%   \begin{note} ... \end{note}                       untitled box (introductions, instructions)
%   \begin{fluencysheet}{date}{title} ... \end{fluencysheet}   numbered starter sheet (Automatismes); items:
%   \mxfq{role}{tag}{question}{answer}{remark}         role label, diagnostic tag (teacher), question, answer and remark
%                                                      (teacher edition); \mxchoices{A}{B}{C}{D} for a multiple choice
%   \mxtag{CODE}             diagnostic tag, teacher edition style
%   \mxarraystretch{x}       row spacing for the next tables in the current group
%   \mxbanner{text}, \mxbanner*{text}   label line of an assessment paper (training; reserved for assessment)
%   \mxcontinued{text}       running line at the top of a continued paper
%   \mxpseudo{lines}         algorithm or code read in a question (lines separated by \\, indent with \mxtab)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-env}[2026/10/12 Maths Explorer environments]
\RequirePackage[framemethod=default]{mdframed}
\RequirePackage[most]{tcolorbox}
\RequirePackage{environ}
\RequirePackage{refcount}

\newcounter{mxexample}[chapter]
\newcounter{mxexercise}[chapter]
\newcounter{mxactivity}[chapter]
\renewcommand{\themxexample}{\arabic{mxexample}}
\renewcommand{\themxexercise}{\thechapter.\arabic{mxexercise}}
\renewcommand{\themxactivity}{\arabic{mxactivity}}

\mdfdefinestyle{mxbox}{linewidth=2pt,topline=false,bottomline=false,rightline=false,leftline=true,
  innerleftmargin=8pt,innerrightmargin=4pt,innertopmargin=3pt,innerbottommargin=4pt,skipabove=6pt,skipbelow=4pt}

% \mx@title{label key}{counter name or empty}{optional title}: the run-in title of a box.
% Run-in title: the box text continues on the same line (a list or display starts on its own line anyway).
\newcommand{\mx@title}[3]{{\sffamily\bfseries\color{mx@accent}\mxlabelof{#1}\if\relax\detokenize{#2}\relax\else~\csname the#2\endcsname\fi
  \if\relax\detokenize{#3}\relax\else{\normalcolor\ \textperiodcentered\ #3}\fi.}\enspace\ignorespaces}

% \mx@defbox{name}{colour}{background}{counter or empty}: defines environment <name>[title].
\newcommand{\mx@defbox}[4]{%
  \newenvironment{#1}[1][]{%
    \if\relax\detokenize{#4}\relax\else\refstepcounter{#4}\fi
    \colorlet{mx@accent}{#2}\mxneed{5}%
    \begin{mdframed}[style=mxbox,linecolor=#2,backgroundcolor=#3]%
    \mx@title{#1}{#4}{##1}}%
  {\end{mdframed}}}
\mx@defbox{keypoint}{mxmint}{mxkeyfill}{}
\mx@defbox{definition}{mxmint}{mxkeyfill}{}
\mx@defbox{theorem}{mxmint}{mxkeyfill}{}
\mx@defbox{method}{mxink}{white}{}
\mx@defbox{example}{mxink}{white}{mxexample}
\mx@defbox{pitfall}{mxwarn}{mxpitfallfill}{}
\mx@defbox{activity}{mxmint}{white}{mxactivity}
\mx@defbox{exercise}{mxmuted}{white}{mxexercise}
\mx@defbox{application}{mxmuted}{white}{}
\mx@defbox{homework}{mxwarn}{white}{}
\mx@defbox{exitticket}{mxwarn}{white}{}
\mx@defbox{fluency}{mxink}{mxpaper}{}
\mx@defbox{objectives}{mxteacher}{white}{}
\mx@defbox{summary}{mxmint}{mxkeyfill}{}
\mx@defbox{problem}{mxink}{white}{}
\mx@defbox{prerequisites}{mxmuted}{mxpaper}{}
% beyond: content outside the official programme (an extension for interested students), never assessed.
\mx@defbox{beyond}{mxmuted}{white}{}

% proof: not boxed; ends with a square.
\newenvironment{proof}{\par\mxneed{3}{\sffamily\bfseries\mxlabelof{proof}.}\ }{\hfill$\square$\par}

% Teacher-only boxes: the body is read by environ and dropped in the student edition.
\NewEnviron{solution}[1][]{\ifmxteacher\colorlet{mx@accent}{mxteacher}\mxneed{4}%
  \begin{mdframed}[style=mxbox,linecolor=mxteacher,backgroundcolor=mxsolutionfill]\mx@title{solution}{}{#1}\BODY\end{mdframed}\fi}
\NewEnviron{teachernote}[1][]{\ifmxteacher\colorlet{mx@accent}{mxteacher}\mxneed{4}%
  \begin{mdframed}[style=mxbox,linecolor=mxteacher,backgroundcolor=white]\mx@title{teachernote}{}{#1}\BODY\end{mdframed}\fi}

\newenvironment{figurebox}[1][]{\par\mxneed{8}\begin{center}\def\mx@caption{#1}}%
  {\if\relax\detokenize\expandafter{\mx@caption}\relax\else\par\smallskip{\small\color{mxmuted}\mx@caption}\fi\end{center}}

\newcommand{\mxanswer}[1]{\ifmxteacher\par{\color{mxteacher}\sffamily\bfseries\mxlabelof{answer}.}\ #1\par\fi}
\newcommand{\mxblank}[1]{\ifmxteacher\textbf{\color{mxteacher}#1}\else\makebox[1.1cm]{\dotfill}\fi}
\newcommand{\mxlines}[1]{\ifmxteacher\else\par\vspace{2pt}\foreach\mx@i in {1,...,#1}{\noindent\textcolor{mxline}{\rule{\linewidth}{.4pt}}\par\vspace{5mm}}\fi}
\newtcbox{\mxchip}{on line,colback=mxmintpale,colframe=mxmintpale,coltext=mxink,boxrule=0pt,arc=2mm,
  left=3pt,right=3pt,top=1pt,bottom=1pt,fontupper=\sffamily\scriptsize}

% Untitled box.
\newenvironment{note}{\mxneed{4}\begin{mdframed}[style=mxbox,linecolor=mxink,backgroundcolor=white]}{\end{mdframed}}

% Starter sheets: numbered across the whole book, five items each.
\newcounter{mxsheet}
\newcommand{\mxtag}[1]{\textcolor{mxmuted}{\footnotesize\sffamily[#1]}}
\newenvironment{fluencysheet}[2]{\refstepcounter{mxsheet}\mxneed{9}%
  \begin{mdframed}[style=mxbox,linecolor=mxink,backgroundcolor=white,innertopmargin=4pt,innerbottommargin=5pt]%
  \noindent{\color{mxink}\sffamily\bfseries\mxlabelof{sheet}~\themxsheet}\hspace{.6em}%
  {\color{mxmuted}\small\sffamily #1}\hspace{.6em}{\itshape\small #2}\par\vspace{3pt}%
  \begin{enumerate}[label=\textbf{\arabic*.},leftmargin=1.5em,itemsep=3pt,parsep=0pt]}%
  {\end{enumerate}\end{mdframed}}
% \mxfq{role}{tag}{question}{answer}{remark}: one item of a starter sheet.
\newcommand{\mxfq}[5]{\item{\color{mxmuted}\scriptsize\sffamily #1}\ \ifmxteacher\mxtag{#2}\fi\ #3%
  \ifmxteacher\par\smallskip\noindent{\color{mxteacher}\small\textbf{\mxlabelof{answershort}}\ #4}%
    \if\relax\detokenize{#5}\relax\else\par\noindent{\color{mxmuted}\footnotesize\itshape #5}\fi\fi}
\newcommand{\mxchoices}[4]{\par\smallskip\noindent\begin{tabular}{@{}*{4}{p{.22\linewidth}}@{}}
  \textbf{A.}~#1 & \textbf{B.}~#2 & \textbf{C.}~#3 & \textbf{D.}~#4\end{tabular}}
\newcommand{\mxarraystretch}[1]{\renewcommand{\arraystretch}{#1}}
% \mxtitleblock{title}{subtitle}: centred title at the top of a sheet-layout book.
\newcommand{\mxtitleblock}[2]{\begin{center}{\Large\sffamily\bfseries\color{mxink}#1}\\[3pt]{\sffamily\color{mxmuted}#2}\end{center}\vspace{2pt}}

% ---- Session books (STMG) -----------------------------------------------------------------------------------------
% \mxsession{n}{date}{duration}{title}{chapter}: new page, contents entry, dark header band.
\newcommand{\mxsession}[5]{\mx@newblock\phantomsection\addcontentsline{toc}{section}{\mxlabelof{session} #1 · #4}%
  \begin{tcolorbox}[enhanced,colback=mxink,colframe=mxink,boxrule=0pt,arc=1.5mm,left=4mm,right=4mm,top=3mm,bottom=3mm]
  {\color{white}\sffamily\bfseries\Large\mxlabelof{session} #1\hfill #4}\par\vspace{2mm}
  {\color{white!85}\sffamily\small #5\hfill #2\quad\textbullet\quad #3}
  \end{tcolorbox}}
% \mxtest{n}{version}{title}{skills}: header of a supervised test.
\newcommand{\mxtest}[4]{\mx@newblock\section*{\mxlabelof{test} #1 · \mxlabelof{version} #2}%
  \addcontentsline{toc}{section}{\mxlabelof{testshort} #1 · \mxlabelof{version} #2}%
  \begin{tcolorbox}[enhanced,colback=mxink,colframe=mxink,boxrule=0pt,arc=2mm]
  \color{white}\sffamily\textbf{#3}\hfill\textbf{\mxlabelof{duration}}\quad\textbf{\mxlabelof{mark}}\\
  \mxlabelof{name}\ \rule{6cm}{.4pt}\hfill\mxlabelof{class}\ \rule{2.5cm}{.4pt}
  \end{tcolorbox}
  \mxskills{#4}\par\smallskip\textit{\mxlabelof{testrules}}}
\newcommand{\mxskills}[1]{{\small\sffamily\textbf{\mxlabelof{skills}} #1}}
\newcommand{\mxdifficulty}[1]{\hfill{\small\sffamily\color{mxwarn}#1}}
\newcommand{\mxpoints}[1]{\hfill{\small\sffamily\color{mxink}[#1 \mxlabelof{points}]}}
\newcommand{\mxtwocols}[2]{\begin{minipage}[t]{.48\textwidth}#1\end{minipage}\hfill\begin{minipage}[t]{.48\textwidth}#2\end{minipage}}
% \mxfurther{references}: textbook page and exercise numbers only; no textbook statement is reproduced.
\newcommand{\mxfurther}[1]{\begin{note}\textbf{\mxlabelof{further}} #1. \mxlabelof{furthernote}\end{note}}
% Exercise bank: \mxexdef{key}{target}{statement}{teacher solution}{answer lines} stores an application exercise
% (a bank unit defines, a session unit prints it with \mxexuse{key}); the target is shown in the teacher edition only.
\NewDocumentCommand{\mxexdef}{m m +m +m m}{\expandafter\long\expandafter\def\csname mx@ex@#1\endcsname{%
  \begin{application}#3\mxlines{#5}\end{application}\begin{solution}\textbf{\mxlabelof{target}} #2.\par #4\end{solution}}}
\newcommand{\mxexuse}[1]{\ifcsname mx@ex@#1\endcsname\csname mx@ex@#1\endcsname
  \else\begin{pitfall}\mxlabelof{missingexercise} #1.\end{pitfall}\fi}
% \mxcover{title}{subtitle}{description}{details}{year}: full-page cover, edition named at the bottom.
\newcommand{\mxcover}[5]{\begin{titlepage}\pagecolor{mxink}\color{white}\centering\vspace*{18mm}
  {\sffamily\bfseries\fontsize{34}{38}\selectfont #1\par}\vspace{3mm}{\sffamily\fontsize{25}{29}\selectfont #2\par}
  \vspace{8mm}\textcolor{mxmintpale}{\rule{62mm}{1.3pt}}\par\vspace{7mm}
  {\sffamily\fontsize{17}{21}\selectfont #3\par}\vspace{4mm}{\sffamily\large #4\par}\vspace{3mm}{\sffamily\Large #5\par}
  \vfill{\Large\sffamily\bfseries\ifmxteacher\mxlabelof{teacher}\else\mxlabelof{student}\fi\par}\vspace{6mm}
  \end{titlepage}\nopagecolor\color{black}}

% ---- Worksheets (Seconde) ---------------------------------------------------------------------------------------------
% \mxgrid{h}: squared working space, h cm high (always printed).
\newcommand{\mxgrid}[1]{\par\smallskip\begin{tikzpicture}\draw[step=.2cm,mxline,very thin] (0,0) grid ({\linewidth-1pt},{#1cm});
  \draw[step=.8cm,mxmuted!50,thin] (0,0) grid ({\linewidth-1pt},{#1cm});\end{tikzpicture}\par}
% \mxanswerspace[h]{answer}: a grid of h cm for students, the worked answer for teachers.
\NewDocumentCommand{\mxanswerspace}{O{4} +m}{\ifmxteacher\begin{solution}#2\end{solution}\else\mxgrid{#1}\fi}
% \mxwriteproof[h]{proof}: a proof for students to write, the proof for teachers.
\NewDocumentCommand{\mxwriteproof}{O{4} +m}{\par\textbf{\mxlabelof{writeproof}}\mxanswerspace[#1]{#2}}

% ---- Chapter books (Première) ----------------------------------------------------------------------------------------
% \mxcorrections{n}: teacher section with the solutions of chapter n, on a new page (build splits on its heading).
\newcommand{\mxcorrections}[1]{\mx@newblock\section*{\mxlabelof{corrections} #1}}
% \mxexerciseitem{n}{title}: run-in exercise heading "En · title." (numbers cited by the solutions).
\newcommand{\mxexerciseitem}[2]{\mxneed{3}\paragraph{E#1 \textperiodcentered\ #2.}}
% \mxexercisehead{label}{title}: numbered exercise heading (chapter.n) for exercises written as running text.
\newcommand{\mxexercisehead}[2]{\mxneed{5}\refstepcounter{mxexercise}\subsection*{\mxlabelof{exercise} \themxexercise\ \textperiodcentered\ #2}\label{#1}}

% ---- Lines of assessments and algorithms (units never style text by hand) -------------------------------------------
\newcommand{\mxbanner}{\@ifstar{\mx@banner{mxwarn}}{\mx@banner{mxmint}}}
\newcommand{\mx@banner}[2]{\par{\sffamily\bfseries\color{#1}#2\par}}
\newcommand{\mxcontinued}[1]{\par\noindent{\sffamily\bfseries\color{mxink}#1}\par}
\newcommand{\mxpseudo}[1]{\par\smallskip{\ttfamily\small #1\par}}
\newcommand{\mxtab}{\hspace*{2.4em}}

% Counts written in words, measured from the list itself (two compilations, as for page references):
% \mxcounted{key} as the last line of an enumerate records its number of items; \mxcount{key} prints that number as a
% word in the document language (cinq / five). Adding or removing a question updates the sentence automatically.
\newcommand{\mxcounted}[1]{\protected@edef\@currentlabel{\arabic{enumi}}\label{\mxunitid:count:#1}}
\newcommand{\mxcount}[1]{\mxlabelof{count\getrefnumber{\mxunitid:count:#1}}}
% \mxCount{key}: the same count, capitalised, at the start of a sentence (Cinq / Five).
\newcommand{\mxCount}[1]{\mxlabelof{Fcount\getrefnumber{\mxunitid:count:#1}}}
% \mxtally{key} before each counted element (an exercise of a paper) adds one to that tally; \mxTallied{key} prints the
% final tally as a capitalised word (Quatre / Four), so a header such as "Quatre exercices indépendants" follows the paper.
% The last value is written to the .aux file; the first compilation prints ?? and latexmk's second pass resolves it.
\newcommand{\mxtally}[1]{\@ifundefined{c@mxt@\mxunitid:#1}{\newcounter{mxt@\mxunitid:#1}}{}\stepcounter{mxt@\mxunitid:#1}%
  \immediate\write\@auxout{\string\global\string\@namedef{mx@tally@\mxunitid:#1}{\arabic{mxt@\mxunitid:#1}}}}
\newcommand{\mxTallied}[1]{\mxlabelof{Count\@ifundefined{mx@tally@\mxunitid:#1}{0}{\@nameuse{mx@tally@\mxunitid:#1}}}}
