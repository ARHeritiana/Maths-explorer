% mx-figures.sty -- colours (named palette matching the site tokens "Cahier", light theme; no raw RGB in units), TikZ
% and pgfplots styles. Print palette: black ink on white paper, one red accent for the object studied, green for what
% is correct (teacher answers), dark red for warnings. Colour carries meaning only; borders, not shadows.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-figures}[2026/11/07 Maths Explorer figures]
\RequirePackage[table]{xcolor}
\definecolor{mxink}{HTML}{000000}
\definecolor{mxinktwo}{HTML}{1F1F1F}
\definecolor{mxmuted}{HTML}{595959}
\definecolor{mxline}{HTML}{CDCDCD}
\definecolor{mxlinestrong}{HTML}{6E6E6E}
\definecolor{mxpaper}{HTML}{F2F2F2}
\definecolor{mxaccent}{HTML}{D90012}
\definecolor{mxaccentsoft}{HTML}{FFF0F1}
\definecolor{mxpos}{HTML}{0A7A43}
\definecolor{mxpossoft}{HTML}{E1F3EA}
\definecolor{mxneg}{HTML}{B3000F}
\definecolor{mxnegsoft}{HTML}{FBE7E5}
\definecolor{mxmark}{HTML}{FFE14D}
% Names used by the units and older styles keep working: mint = the accent, teacher = what is correct, warn = a warning.
\colorlet{mxmint}{mxaccent}
\colorlet{mxmintpale}{mxaccentsoft}
\colorlet{mxteacher}{mxpos}
\colorlet{mxwarn}{mxneg}
\colorlet{mxkeyfill}{mxpaper}
\colorlet{mxpitfallfill}{mxnegsoft}
\colorlet{mxsolutionfill}{mxpossoft}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,patterns,decorations.pathreplacing,trees,shapes.geometric,angles,quotes,3d}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\tikzset{mxcurve/.style={mxaccent,thick}, mxaux/.style={mxmuted,dashed}, mxpoint/.style={circle,fill=mxink,inner sep=1.3pt}, mxaxisline/.style={->,mxmuted}}
\pgfplotsset{mxaxis/.style={axis lines=middle,grid=major,grid style={mxline},tick label style={font=\footnotesize},
  every axis plot/.append style={thick}}}
% Square-grid axes for function graphs (former Seconde style "coursaxe").
\pgfplotsset{mxgridaxis/.style={axis lines=middle,grid=both,minor tick num=1,width=11cm,height=7cm,xlabel={$x$},
  ylabel={$y$},tick label style={font=\small},samples=100}}
