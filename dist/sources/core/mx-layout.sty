% mx-layout.sty -- page geometry, headings, running heads and the page-break policy.
% Page breaks: units never use \clearpage or \newpage (a lint enforces it). Boxes and headings reserve space with
% \Needspace; chapters start on a new page through the class.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mx-layout}[2026/10/12 Maths Explorer native document layout]
\RequirePackage{geometry,fancyhdr,titlesec,needspace,microtype,enumitem,booktabs,array,tabularx,longtable,multicol,eso-pic}
\def\mx@booklet{booklet}\def\mx@figs{slide-figs}
% Print palette formerly applied to PDF drawing operators after compilation. Figure exports retain their original
% palette; documents now produce the print colours directly, without editing PDF streams.
\ifx\mx@layout\mx@figs\else
  \definecolor{mxink}{rgb}{.09,.40,.33}
  \definecolor{mxmint}{rgb}{.09,.40,.33}
  \definecolor{mxmintpale}{rgb}{.94,.96,.98}
  \definecolor{mxteacher}{rgb}{.22,.32,.52}
  \definecolor{mxwarn}{rgb}{.64,.26,.35}
  \definecolor{mxmuted}{rgb}{.09,.40,.33}
\fi
\definecolor{mxband}{HTML}{0B1224}
\definecolor{mxbandaccent}{HTML}{75EFC9}
\definecolor{mxbandlanguage}{HTML}{B5A5FF}
\definecolor{mxfooter}{rgb}{.32,.38,.47}
\definecolor{mxfootrule}{rgb}{.8,.85,.9}
% Pale fills were neutral enough that the former stream mapper left them alone. Keep those original tints even
% though their saturated accent inks now use the print palette above.
\definecolor{mxkeyfill}{rgb}{.92765,.97000,.95412}
\definecolor{mxpitfallfill}{rgb}{.98510,.96843,.95980}
\definecolor{mxsolutionfill}{rgb}{.97020,.97694,.98541}
% Page-local frame, shared by books and the cached empty pages used when the builders assemble excerpts. Absolute
% sheet counts are independent of front/main-matter numbering. Reading the total from the aux file settles on rerun.
\providecommand{\mxdocumentpages}{?}
\newcount\mx@framestart
\newcommand{\mx@put}[3]{\put(\LenToUnit{#1},\LenToUnit{#2}){#3}}
\AddToHook{enddocument/afterlastpage}{%
  \immediate\write\@auxout{\string\gdef\string\mxdocumentpages{\the\ReadonlyShipoutCounter}}}
\newcommand{\mxpageframe}{%
  \AtPageUpperLeft{%
    \mx@put{0bp}{-34bp}{\color{mxband}\rule{\paperwidth}{34bp}}%
    \mx@put{23bp}{-35.75bp}{\color{mxbandaccent}\rule{\dimexpr\paperwidth-46bp\relax}{1.5bp}}%
    \mx@put{23bp}{-23bp}{\makebox(0,0)[lb]{\sffamily\bfseries\fontsize{10bp}{12bp}\selectfont\color{mxbandaccent}MATHS EXPLORER}}%
    \mx@put{\dimexpr\paperwidth-42bp\relax}{-23bp}{\makebox(0,0)[lb]{\sffamily\fontsize{8bp}{10bp}\selectfont\color{mxbandlanguage}\mxtr{FR}{EN}}}}%
  \AtPageLowerLeft{%
    \mx@put{0bp}{0bp}{\color{white}\rule{\paperwidth}{38bp}}%
    \mx@put{23bp}{26.75bp}{\color{mxfootrule}\rule{\dimexpr\paperwidth-46bp\relax}{.5bp}}%
    \mx@put{23bp}{14bp}{\makebox(0,0)[lb]{\sffamily\fontsize{7bp}{9bp}\selectfont\color{mxfooter}\mxtr{Observer. Conjecturer. Démontrer.}{Observe. Conjecture. Prove.}}}%
    \mx@put{\dimexpr\paperwidth-64bp\relax}{14bp}{\makebox(0,0)[lb]{\sffamily\fontsize{7bp}{9bp}\selectfont\color{mxfooter}\number\numexpr\ReadonlyShipoutCounter-\mx@framestart\relax\ / \mxdocumentpages}}}}
\ifx\mx@layout\mx@figs\else
  \AddToShipoutPictureBG{\mxpageframe}
\fi
% Empty, numbered pages carry exactly the same native frame as a resource. Builders copy these compiled pages;
% all dimensions, fonts, colours and wording stay here, rather than in a Python PDF styler.
\newcommand{\mxframeonly}[1]{\clearpage\mx@framestart=\ReadonlyShipoutCounter\def\mxdocumentpages{#1}%
  \foreach\mx@frameindex in {1,...,#1}{\null\clearpage}}
\ifx\mx@layout\mx@booklet
  \geometry{a4paper,inner=24mm,outer=19mm,top=21mm,bottom=22mm,headheight=15pt}
\else\ifx\mx@layout\mx@figs
  \geometry{paperwidth=16cm,paperheight=9cm,margin=4mm}\pagestyle{empty}
\else
  \geometry{a4paper,left=19mm,right=19mm,top=17mm,bottom=17mm,headheight=14pt}
\fi\fi
\ifx\mx@layout\mx@booklet\else\renewcommand{\thesection}{\arabic{section}}\fi   % no chapters outside booklets
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{2.5em}   % a looser line rather than an overfull one (long inline formulas)
\tolerance=1000
\hfuzz=0.5pt   % an excess under 0.5 pt (0.18 mm) is invisible and not reported as overfull
\setlength{\parskip}{4pt plus 1pt}
\renewcommand{\familydefault}{\rmdefault}
\titleformat{\chapter}[display]{\sffamily\bfseries\color{mxink}}{\large\color{mxmint}\MakeUppercase{\chaptername}~\thechapter}{4pt}{\huge}[{\color{mxmint}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{14pt}
\titleformat{\section}{\needspace{5\baselineskip}\Large\sffamily\bfseries\color{mxink}}{\thesection}{.7em}{}
\titleformat{\subsection}{\needspace{4\baselineskip}\large\sffamily\bfseries\color{mxink}}{\thesubsection}{.6em}{}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{.3pt}
\fancyhead[LE,RO]{\small\sffamily\color{mxmuted}\leftmark}
\fancyfoot[LE,RO]{\small\sffamily\bfseries\thepage}
\fancyfoot[RE,LO]{\small\sffamily\color{mxmuted}\ifmxteacher\mxlabelof{teacher}\else\mxlabelof{student}\fi}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[LE,RO]{\small\sffamily\bfseries\thepage}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
% \mxneed{n}: keep the next n lines together (reserve space or start a new page).
\newcommand{\mxneed}[1]{\Needspace{#1\baselineskip}}

% Sheet layout (no chapters): the table of contents stays on the current page, the running head shows the current
% section and the edition.
\ifx\mx@layout\mx@booklet\else
  \makeatletter
  \renewcommand{\tableofcontents}{\section*{\contentsname}\@starttoc{toc}}
  \makeatother
  \setlength{\parskip}{0pt}
  \titleformat{\section}{\needspace{5\baselineskip}\Large\sffamily\bfseries\color{mxink}}{\thesection}{.7em}{}[\vspace{-2pt}{\color{mxline}\titlerule}]
  \titlespacing*{\section}{0pt}{12pt}{6pt}
  % ragged right, hyphenation strongly discouraged: short items, line counts close between French and English
  \AtBeginDocument{\raggedright\hyphenpenalty=2000\exhyphenpenalty=2000}
  \fancyhf{}
  \fancyhead[L]{\small\sffamily\color{mxmuted}\rightmark}
  \fancyhead[R]{\small\sffamily\color{mxmuted}\ifmxteacher\mxlabelof{teacher}\else\mxlabelof{student}\fi}
  \fancyfoot[C]{\small\sffamily\thepage}
  \renewcommand{\sectionmark}[1]{\markright{#1}}
  \fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\sffamily\thepage}}
\fi
% The native frame supplies the running header and footer in every page style. Keep the original text geometry;
% do not squeeze or scale mathematical content to fit a second frame.
\pagestyle{empty}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}}
