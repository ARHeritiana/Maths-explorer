diff --git a/tests/exercises.test.mjs b/tests/exercises.test.mjs
new file mode 100644
index 0000000..e5b57a3
--- /dev/null
+++ b/tests/exercises.test.mjs
@@ -0,0 +1,145 @@
+// Seeded exercises: the random numbers, the generators (many seeds, checked by an independent method), the HTML and TeX renderers
+// and the address of a sheet. Imports site/js directly (pure modules, no build needed).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeRng, parseSeed, draw, MAX_SEED } from '../site/js/exercises-prng.js';
+import { GENERATORS, poly, makeSheet } from '../site/js/exercises-generators.js';
+import { segments, toHtml, toTex, exerciseHtml, texDocument } from '../site/js/exercises-render.js';
+import { parseSheet, sheetTab, isExerciseRoute, exercisesPage } from '../site/js/exercises.js';
+
+const t = (pair) => pair[0];
+
+test('the random numbers: reproducible, in range, a fixed sequence', () => {
+  const a = makeRng(12345), b = makeRng(12345);
+  const xs = Array.from({ length: 50 }, () => a.next()), ys = Array.from({ length: 50 }, () => b.next());
+  assert.deepEqual(xs, ys);
+  assert.ok(xs.every((x) => x >= 0 && x < 1));
+  assert.notDeepEqual(xs, Array.from({ length: 50 }, ((r) => () => r.next())(makeRng(12346))));
+  const r = makeRng(7);
+  for (let i = 0; i < 2000; i++) { const n = r.int(-3, 4); assert.ok(Number.isInteger(n) && n >= -3 && n <= 4); }
+  // Locked values: if these change, every seed ever shared changes its exercise.
+  const lock = makeRng(1);
+  assert.deepEqual([lock.int(0, 99), lock.int(0, 99), lock.int(0, 99)], LOCK_RNG);
+});
+const LOCK_RNG = [62, 0, 52];
+
+test('seed parsing accepts integers from 0 to 2^32-1 only', () => {
+  assert.equal(parseSeed('0'), 0);
+  assert.equal(parseSeed(' 4271 '), 4271);
+  assert.equal(parseSeed(String(MAX_SEED)), MAX_SEED);
+  for (const bad of ['', 'x', '-1', '1.5', '4294967296', '99999999999', null, undefined]) assert.equal(parseSeed(bad), null, String(bad));
+  assert.throws(() => draw(makeRng(1), (r) => r.next(), () => false, 20), /no admissible draw/);
+});
+
+// Independent reader of a polynomial printed by poly(): coefficients of x^2, x, 1 from the string alone.
+function readPoly(s) {
+  const out = { a: 0, b: 0, c: 0 };
+  for (const m of s.matchAll(/([+-]?)(\d*)(x\^2|x)?/g)) {
+    if (!m[0]) continue;
+    const k = (m[1] === '-' ? -1 : 1) * (m[2] === '' ? (m[3] ? 1 : 0) : Number(m[2]));
+    if (m[3] === 'x^2') out.a += k; else if (m[3] === 'x') out.b += k; else out.c += k;
+  }
+  return out;
+}
+
+test('poly writes and reads back every small trinomial', () => {
+  for (let a = -4; a <= 4; a++) for (let b = -4; b <= 4; b++) for (let c = -4; c <= 4; c++) {
+    if (a === 0 && b === 0 && c === 0) continue;
+    const s = poly(a, b, c);
+    assert.deepEqual(readPoly(s), { a, b, c }, s);
+    assert.ok(!/\+-|--|\+\+|^\+/.test(s), s);
+  }
+  assert.equal(poly(1, -5, 6), 'x^2-5x+6');
+  assert.equal(poly(-1, 1, -1), '-x^2+x-1');
+});
+
+test('quadratic-roots: 3 levels x 2000 seeds satisfy the rules of the level, checked independently', () => {
+  const g = GENERATORS['quadratic-roots'];
+  const seen = { 1: new Set(), 2: new Set(), 3: new Set() }, kinds = { two: 0, double: 0, none: 0 };
+  for (const lv of g.levels) for (let seed = 0; seed < 2000; seed++) {
+    const ex = g.generate(seed, lv.id);
+    const { a, b, c } = readPoly(ex.parts[0].prompt.match(/\$([^$]+)\$/)[1]);
+    const f = ex.facts;
+    assert.deepEqual([a, b, c], [f.a, f.b, f.c], `statement matches the model (level ${lv.id}, seed ${seed})`);
+    assert.ok(a !== 0 && b !== 0 && c !== 0, 'full trinomial');
+    assert.ok(Math.abs(b) <= 60 && Math.abs(c) <= 80, 'coefficients stay small');
+    const delta = b * b - 4 * a * c;
+    assert.equal(f.delta, delta);
+    // roots by exact test: each listed root zeroes the polynomial, and the count matches the sign of delta
+    for (const r of f.roots) { assert.ok(Number.isInteger(r)); assert.equal(a * r * r + b * r + c, 0); }
+    assert.equal(f.roots.length, delta > 0 ? 2 : delta === 0 ? 1 : 0);
+    if (delta > 0) assert.ok(Number.isInteger(Math.sqrt(delta)), 'delta is a perfect square');
+    if (lv.id === 1) assert.ok(a === 1 && delta > 0);
+    if (lv.id === 2) assert.ok(a !== 1 && delta > 0);
+    kinds[delta > 0 ? 'two' : delta === 0 ? 'double' : 'none']++;
+    // every part has a prompt and a non-empty answer, balanced dollar signs
+    assert.equal(ex.parts.length, 3);
+    for (const p of ex.parts) {
+      assert.ok(p.prompt && p.answer.length >= 1);
+      for (const line of [p.prompt, ...p.answer]) assert.equal((line.match(/\$/g) || []).length % 2, 0, line);
+    }
+    seen[lv.id].add(`${a},${b},${c}`);
+    assert.deepEqual(g.generate(seed, lv.id), ex, 'same seed, same exercise');
+  }
+  assert.ok(kinds.double > 50 && kinds.none > 50, JSON.stringify(kinds));
+  // Level 1 is finite by design: unordered pairs of distinct non-zero roots in [-9, 9] with a non-zero sum = C(18,2) - 9 = 144.
+  // 2000 seeds reach all of them. After that a seed repeats an earlier exercise: for endless variety, widen the family, not the seed.
+  assert.equal(seen[1].size, 144);
+  assert.ok(seen[2].size > 300 && seen[3].size > 300, 'enough variety: ' + [1, 2, 3].map((k) => seen[k].size));
+});
+
+test('the answer text contains the right numbers (spot checks)', () => {
+  const ex = GENERATORS['quadratic-roots'].generate(4271, 1);
+  const { a, b, c, delta, roots } = ex.facts;
+  assert.ok(ex.parts[0].answer[0].endsWith(`=${delta}$`));
+  assert.ok(ex.parts[1].answer.join(' ').includes(`S=\\{${roots.join(' ; ')}\\}`));
+  assert.equal(a, 1);
+  assert.ok(ex.parts[0].prompt.includes(poly(a, b, c)));
+  assert.deepEqual(GENERATORS['quadratic-roots'].generate(4271, 1).facts, LOCK_FACTS);
+});
+const LOCK_FACTS = { a: 1, b: 14, c: 48, delta: 4, roots: [-8, -6] };   // (x+8)(x+6), checked by hand
+
+test('makeSheet: consecutive seeds, wrapping at 2^32', () => {
+  const s = makeSheet('quadratic-roots', 2, MAX_SEED - 1, 4);
+  assert.deepEqual(s.map((e) => e.seed), [MAX_SEED - 1, MAX_SEED, 0, 1]);
+});
+
+test('renderers: escaping, maths delimiters, a self-contained balanced TeX document', () => {
+  assert.deepEqual(segments('a $x$ b'), [{ math: false, s: 'a ' }, { math: true, s: 'x' }, { math: false, s: ' b' }]);
+  assert.equal(toHtml('1 < 2 & $x<y$'), '1 &lt; 2 &amp; \\(x&lt;y\\)');
+  assert.equal(toTex('50% de a_b & $x_1$'), '50\\% de a\\_b \\& $x_1$');
+  const sheet = makeSheet('quadratic-roots', 3, 99, 5);
+  for (const teacher of [false, true]) {
+    const tex = texDocument(sheet, { teacher, url: 'https://example.org/#exercises' });
+    assert.ok(tex.includes(teacher ? '\\teachertrue % EDITION' : '\\teacherfalse % EDITION'));
+    assert.ok(tex.startsWith('% Maths Explorer'));
+    for (const e of sheet) assert.ok(tex.includes(`{${e.seed}}`));
+    const env = (n) => (tex.match(new RegExp('\\\\begin\\{' + n + '\\}', 'g')) || []).length === (tex.match(new RegExp('\\\\end\\{' + n + '\\}', 'g')) || []).length;
+    assert.ok(env('enumerate') && env('solution') && env('document'));
+    assert.equal((tex.match(/\\mxexercise\{/g) || []).length, 5);   // 5 uses; the definition has no brace right after
+    assert.ok(!/[\u2013\u2014]/.test(tex), 'no em or en dash');
+    // dollar signs of the body are paired: count outside comments
+    assert.equal((tex.replace(/%.*$/gm, '').match(/\$/g) || []).length % 2, 0);
+  }
+  const html = exerciseHtml(sheet[0], 1);
+  assert.ok(html.includes('data-seed="99"') && html.includes('ex-answer') && (html.match(/<li>/g) || []).length === 3);
+});
+
+test('sheet addresses', () => {
+  assert.deepEqual(parseSheet('2-4271'), { level: 2, seed: 4271, count: 4 });
+  assert.deepEqual(parseSheet('1-0x10'), { level: 1, seed: 0, count: 10 });
+  assert.equal(sheetTab({ level: 3, seed: 5, count: 4 }), '3-5');
+  assert.equal(sheetTab({ level: 3, seed: 5, count: 6 }), '3-5x6');
+  assert.deepEqual(parseSheet(sheetTab({ level: 2, seed: 77, count: 9 })), { level: 2, seed: 77, count: 9 });
+  for (const bad of ['x', '1-', '1-4294967296', '1-5x0', '1-5x21', '0-5', '1-5x']) assert.equal(parseSheet(bad), null, bad);
+  assert.ok(isExerciseRoute(undefined, undefined) && isExerciseRoute('quadratic-roots', undefined) && isExerciseRoute('quadratic-roots', '3-9'));
+  assert.ok(!isExerciseRoute('quadratic-roots', '4-9') && !isExerciseRoute('nope', undefined) && !isExerciseRoute(undefined, '1-1'));
+});
+
+test('the page: index, and a sheet with the right number of exercises', () => {
+  assert.ok(exercisesPage(undefined, undefined, t).includes('#exercises/quadratic-roots'));
+  const page = exercisesPage('quadratic-roots', '2-100x3', t);
+  assert.equal((page.match(/<article class="ex"/g) || []).length, 3);
+  assert.ok(page.includes('value="100"') && page.includes('data-act="tex"') && page.includes('data-act="print"'));
+  assert.ok(!/[\u2013\u2014]/.test(page));
+});
